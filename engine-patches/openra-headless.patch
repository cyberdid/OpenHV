@@ -27,6 +27,15 @@
 
 		public MersenneTwister(int seed)
 		{
+			Reset(seed);
+		}
+
+		public void Reset(int seed)
+		{
+			Array.Clear(mt);
+			index = 0;
+			Last = 0;
+			TotalCount = 0;
 			mt[0] = (uint)seed;
 			for (var i = 1u; i < mt.Length; i++)
 				mt[i] = 1812433253u * (mt[i - 1] ^ (mt[i - 1] >> 30)) + i;
