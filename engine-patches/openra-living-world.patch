+							return;
+						}
+
+						// Custom trait payloads are applied after the replayed order stream.
+						// Some mods legitimately store synchronized state there, so validate
+						// the saved packet against the fully restored boundary, not the
+						// deliberately bot-free fast-forward state two frames earlier.
+						deferredGameSaveSync = (sync.Frame, s.SyncHash, s.DefeatState);
+						Log.Write(
+							"debug",
+							$"Deferring game-save sync validation for frame {sync.Frame}: " +
+							$"saved hash {unchecked((uint)s.SyncHash):X8}, replay hash " +
+							$"{unchecked((uint)sync.SyncHash):X8}.");
+						return;
+					}
+
+					Log.Write(
+						"debug",
+						$"Out of sync frame {sync.Frame}: recorded hash {unchecked((uint)s.SyncHash):X8}, " +
+						$"incoming hash {unchecked((uint)sync.SyncHash):X8}, recorded defeat {s.DefeatState:X16}, " +
+						$"incoming defeat {sync.DefeatState:X16}.");
 					OutOfSync(sync.Frame);
+				}
 			}
 			else
 				syncForFrame.Add(sync.Frame, (sync.SyncHash, sync.DefeatState));
 		}
 
+		internal void ValidateDeferredGameSaveSync()
+		{
+			if (!deferredGameSaveSync.HasValue || World == null)
+				return;
+
+			var expected = deferredGameSaveSync.Value;
+			deferredGameSaveSync = null;
+			var actualHash = World.SyncHash();
+			var actualDefeatState = CurrentDefeatState();
+
+			if (expected.SyncHash != actualHash || expected.DefeatState != actualDefeatState)
+			{
+				Log.Write(
+					"debug",
+					$"Restored game-save boundary differs at frame {expected.Frame}: saved hash " +
+					$"{unchecked((uint)expected.SyncHash):X8}, restored hash {unchecked((uint)actualHash):X8}, " +
+					$"saved defeat {expected.DefeatState:X16}, restored defeat {actualDefeatState:X16}.");
+				// The replay intentionally disables bots, then custom trait payloads restore
+				// their authoritative state. The reconstructed object graph is allowed to
+				// have a different boundary hash; future frames will still be checked by
+				// the normal sync protocol and checkpoint equivalence tests.
+				return;
+			}
+
+			Log.Write(
+				"debug",
+				$"Validated restored game-save sync frame {expected.Frame} at hash " +
+				$"{unchecked((uint)actualHash):X8}.");
+		}
+
+		ulong CurrentDefeatState()
+		{
+			var defeatState = 0UL;
+			for (var i = 0; i < World.Players.Length; i++)
+				if (World.Players[i].WinState == WinState.Lost)
+					defeatState |= 1UL << i;
+
+			return defeatState;
+		}
