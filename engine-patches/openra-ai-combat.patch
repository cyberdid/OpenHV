+		internal void RecordTargetSelection(Squad squad, Actor target)
+		{
+			if (target == null)
+				return;
+
+			var reason = IsFinishingTarget(target)
+				? SquadDecisionReason.FinishingOpportunity
+				: Info.UseStrategicTargetScoring
+					? SquadDecisionReason.StrategicScore
+					: SquadDecisionReason.NearestReachable;
+			RecordDecision(
+				squad,
+				SquadDecisionType.TargetSelected,
+				reason,
+				target.ActorID,
+				SumValue(squad.Units),
+				ActorValue(target));
+		}
+
+		internal bool ShouldRetreat(
+			Squad squad,
+			IReadOnlyCollection<Actor> enemies,
+			bool stockDecision)
+		{
+			var ownValue = SumValue(squad.Units);
+			var enemyValue = SumValue(enemies);
+			var lowHealthAndPower =
+				Info.RetreatHealthPercentage > 0 &&
+				NormalizedHealth(squad.Units) <= Info.RetreatHealthPercentage &&
+				(long)ownValue * 100 < (long)Math.Max(1, enemyValue) * Info.RetreatRelativeValuePercentage;
+			if (!stockDecision && !lowHealthAndPower)
+				return false;
+
+			RecordDecision(
+				squad,
+				SquadDecisionType.Retreat,
+				lowHealthAndPower ? SquadDecisionReason.LowHealthAndPower : SquadDecisionReason.StockThreat,
+				squad.TargetActor?.ActorID ?? 0,
+				ownValue,
+				enemyValue);
+			return true;
+		}
+
+		internal void RecordRegroup(Squad squad)
+		{
+			RecordDecision(
+				squad,
+				SquadDecisionType.Regroup,
+				SquadDecisionReason.RetreatOrder,
+				squad.TargetActor?.ActorID ?? 0,
+				SumValue(squad.Units),
+				0);
+		}
+
+		internal void RecordReengage(Squad squad)
+		{
+			RecordDecision(
+				squad,
+				SquadDecisionType.Reengage,
+				SquadDecisionReason.RegroupComplete,
+				squad.TargetActor?.ActorID ?? 0,
+				SumValue(squad.Units),
+				0);
+		}
+
+		void RecordDecision(
+			Squad squad,
+			SquadDecisionType decision,
+			SquadDecisionReason reason,
+			uint targetActorId,
+			int ownValue,
+			int enemyValue)
+		{
+			foreach (var notify in notifySquadDecision)
+				notify.SquadDecision(
+					decision,
+					reason,
+					squad.Type,
+					squad.Units.Count,
+					targetActorId,
+					ownValue,
+					enemyValue);
+		}
+
+		static int ActorValue(Actor actor)
+		{
+			return actor?.Info.TraitInfoOrDefault<ValuedInfo>()?.Cost ?? 0;
+		}
+
+		static int SumValue(IEnumerable<Actor> actors)
+		{
+			return actors.Sum(ActorValue);
+		}
+
+		static int NormalizedHealth(IEnumerable<Actor> actors)
+		{
+			long current = 0;
+			long maximum = 0;
+			foreach (var actor in actors)
+			{
+				var health = actor.TraitOrDefault<IHealth>();
+				if (health == null)
+					continue;
+
+				current += health.HP;
+				maximum += health.MaxHP;
+			}
+
+			return maximum == 0 ? 100 : (int)(current * 100 / maximum);
