+			if (Info.FinishingAssetsThreshold <= 0)
+				return false;
+
+			var statistics = target.Owner.PlayerActor.TraitOrDefault<PlayerStatistics>();
+			return statistics != null &&
+				statistics.DeathsCost >= Info.FinishingLossThreshold &&
+				statistics.ArmyValue + statistics.AssetsValue <= Info.FinishingAssetsThreshold;
+		}
