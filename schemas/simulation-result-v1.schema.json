{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyberdid/OpenHV/schemas/simulation-result-v1.schema.json",
  "title": "Universe simulation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "build",
    "config",
    "endReason",
    "endDetail",
    "startedUtc",
    "endedUtc",
    "worldTick",
    "simulatedSeconds",
    "synchronizedStateHash",
    "naturalWinners",
    "scoreLeader",
    "players"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "build": { "$ref": "#/$defs/build" },
    "config": { "$ref": "#/$defs/config" },
    "endReason": {
      "enum": [
        "natural-victory",
        "faction-collapse",
        "observation-horizon",
        "world-tick-limit",
        "stalemate",
        "invalid-configuration",
        "desync",
        "crash",
        "external-cancel",
        "watchdog-timeout"
      ]
    },
    "endDetail": { "type": "string" },
    "startedUtc": { "type": "string", "format": "date-time" },
    "endedUtc": { "type": "string", "format": "date-time" },
    "worldTick": { "type": "integer", "minimum": 0 },
    "simulatedSeconds": { "type": "number", "minimum": 0 },
    "synchronizedStateHash": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}$"
    },
    "naturalWinners": {
      "type": "array",
      "items": { "$ref": "#/$defs/leader" }
    },
    "scoreLeader": {
      "oneOf": [
        { "$ref": "#/$defs/leader" },
        { "type": "null" }
      ]
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/playerResult" }
    },
    "diplomacy": {
      "type": "array",
      "items": { "$ref": "#/$defs/diplomaticRelation" }
    },
    "tradeRoutes": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeRoute" }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "modId",
        "modVersion",
        "gitCommit",
        "gitDirty"
      ],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "modId": { "type": "string", "minLength": 1 },
        "modVersion": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "minLength": 1 },
        "gitDirty": { "type": "boolean" },
        "executionMode": { "enum": ["graphical", "headless"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "matchId",
        "mapRequest",
        "mapUid",
        "mapTitle",
        "mapHash",
        "botTypes",
        "gameSpeed",
        "gameTimestepMilliseconds",
        "requestedRandomSeed",
        "effectiveRandomSeed",
        "maxWorldTicks",
        "watchdogSeconds",
        "telemetryIntervalTicks",
        "gitCommit",
        "gitDirty",
        "resultPath",
        "players"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "matchId": { "type": "string", "minLength": 1 },
        "mapRequest": { "type": "string", "minLength": 1 },
        "mapUid": { "type": "string", "minLength": 1 },
        "mapTitle": { "type": "string", "minLength": 1 },
        "mapHash": { "type": "string", "minLength": 1 },
        "botTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "type": "boolean" },
        "deterministicSimulation": { "type": "boolean" },
        "gameSpeed": { "type": "string", "minLength": 1 },
        "gameTimestepMilliseconds": { "type": "integer", "minimum": 1 },
        "requestedRandomSeed": {
          "type": ["integer", "null"]
        },
        "effectiveRandomSeed": { "type": "integer" },
        "maxWorldTicks": { "type": "integer", "minimum": 1 },
        "scenarioMode": { "enum": ["conflict", "living-world"] },
        "observationHorizonTicks": { "type": "integer", "minimum": 0 },
        "stalemateWindowTicks": { "type": "integer", "minimum": 0 },
        "stalemateTerminates": { "type": "boolean" },
        "collapsePopulationThreshold": { "type": "integer", "minimum": 0 },
        "collapseStabilityThreshold": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "watchdogSeconds": { "type": "integer", "minimum": 0 },
        "telemetryIntervalTicks": { "type": "integer", "minimum": 0 },
        "civilizationProfile": { "enum": ["balanced", "scarcity", "trade"] },
        "tradeEnabled": { "type": "boolean" },
        "factions": { "type": "array", "items": { "type": "string" } },
        "gitCommit": { "type": "string", "minLength": 1 },
        "gitDirty": { "type": "boolean" },
        "resultPath": { "type": "string" },
        "players": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/playerConfig" }
        }
      }
    },
    "leader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerName", "botType", "faction"],
      "properties": {
        "playerName": { "type": "string" },
        "botType": { "type": "string" },
        "faction": { "type": "string" }
      }
    },
    "playerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "playerName",
        "botType",
        "faction",
        "team",
        "color",
        "spawnPoint",
        "homeCellX",
        "homeCellY"
      ],
      "properties": {
        "slot": { "type": "string" },
        "playerName": { "type": "string" },
        "botType": { "type": "string" },
        "faction": { "type": "string" },
        "team": { "type": "integer", "minimum": 0 },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}([0-9A-F]{2})?$"
        },
        "spawnPoint": { "type": "integer", "minimum": 0 },
        "homeCellX": { "type": "integer" },
        "homeCellY": { "type": "integer" }
      }
    },
    "playerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
            "slot",
            "playerName",
            "botType",
            "faction",
            "team",
            "color",
            "spawnPoint",
            "homeCellX",
            "homeCellY",
            "outcome",
            "score",
            "experience",
            "killsValue",
            "deathsValue",
            "unitsKilled",
            "unitsLost",
            "buildingsKilled",
            "buildingsLost",
            "armyValue",
            "assetsValue",
            "cashAndResources",
            "earned",
            "spent"
      ],
      "properties": {
            "slot": { "type": "string" },
            "playerName": { "type": "string" },
            "botType": { "type": "string" },
            "faction": { "type": "string" },
            "team": { "type": "integer", "minimum": 0 },
            "color": { "type": "string" },
            "spawnPoint": { "type": "integer", "minimum": 0 },
            "homeCellX": { "type": "integer" },
            "homeCellY": { "type": "integer" },
            "outcome": {
              "enum": ["undefined", "won", "lost"]
            },
            "score": { "type": "integer" },
            "experience": { "type": "integer", "minimum": 0 },
            "killsValue": { "type": "integer", "minimum": 0 },
            "deathsValue": { "type": "integer", "minimum": 0 },
            "unitsKilled": { "type": "integer", "minimum": 0 },
            "unitsLost": { "type": "integer", "minimum": 0 },
            "buildingsKilled": { "type": "integer", "minimum": 0 },
            "buildingsLost": { "type": "integer", "minimum": 0 },
            "armyValue": { "type": "integer", "minimum": 0 },
            "assetsValue": { "type": "integer", "minimum": 0 },
            "cashAndResources": { "type": "integer", "minimum": 0 },
            "earned": { "type": "integer", "minimum": 0 },
            "spent": { "type": "integer", "minimum": 0 },
            "civilization": { "$ref": "#/$defs/civilization" }
      }
    },
    "civilization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "foundedTick",
        "population",
        "children",
        "adults",
        "elders",
        "workforce",
        "employed",
        "housing",
        "jobs",
        "food",
        "materials",
        "energy",
        "knowledge",
        "foodProduction",
        "materialsProduction",
        "energyProduction",
        "knowledgeProduction",
        "prosperity",
        "stability",
        "migrationPressure",
        "settlements"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "foundedTick": { "type": "integer", "minimum": 0 },
        "population": { "type": "integer", "minimum": 0 },
        "children": { "type": "integer", "minimum": 0 },
        "adults": { "type": "integer", "minimum": 0 },
        "elders": { "type": "integer", "minimum": 0 },
        "workforce": { "type": "integer", "minimum": 0 },
        "availableWorkforce": { "type": "integer", "minimum": 0 },
        "employed": { "type": "integer", "minimum": 0 },
        "mobilized": { "type": "integer", "minimum": 0 },
        "activeWars": { "type": "integer", "minimum": 0 },
        "warCasualties": { "type": "integer", "minimum": 0 },
        "lastWarCasualties": { "type": "integer", "minimum": 0 },
        "housing": { "type": "integer", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "food": { "type": "integer", "minimum": 0 },
        "materials": { "type": "integer", "minimum": 0 },
        "energy": { "type": "integer", "minimum": 0 },
        "knowledge": { "type": "integer", "minimum": 0 },
        "foodProduction": { "type": "integer", "minimum": 0 },
        "materialsProduction": { "type": "integer", "minimum": 0 },
        "energyProduction": { "type": "integer", "minimum": 0 },
        "knowledgeProduction": { "type": "integer", "minimum": 0 },
        "prosperity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "stability": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "migrationPressure": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "completedTechnologies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentTechnology": {
          "type": ["string", "null"]
        },
        "researchProgress": { "type": "integer", "minimum": 0 },
        "researchCost": { "type": "integer", "minimum": 0 },
        "researchMaterialsSpent": { "type": "integer", "minimum": 0 },
        "researchEnergySpent": { "type": "integer", "minimum": 0 },
        "strategy": {
          "enum": [
            "development",
            "survival",
            "research",
            "trade",
            "mobilization",
            "recovery"
          ]
        },
        "strategySequence": { "type": "integer", "minimum": 0 },
        "strategyTransitionTick": { "type": "integer", "minimum": 0 },
        "plan": {
          "enum": ["opening", "economy", "technology", "recovery"]
        },
        "planReason": {
          "enum": [
            "opening-window",
            "crisis-recovery",
            "technologist-doctrine",
            "economist-doctrine",
            "research-strategy",
            "development-doctrine"
          ]
        },
        "planSequence": { "type": "integer", "minimum": 0 },
        "planTransitionTick": { "type": "integer", "minimum": 0 },
        "plannerRequestSequence": { "type": "integer", "minimum": 0 },
        "lastPlannerRequestTick": { "type": "integer", "minimum": 0 },
        "lastPlannerRequestActor": { "type": ["string", "null"] },
        "combatDecisionSequence": { "type": "integer", "minimum": 0 },
        "lastCombatDecisionTick": { "type": "integer", "minimum": 0 },
        "lastCombatDecision": {
          "enum": ["target-selected", "retreat", "regroup", "reengage", null]
        },
        "lastCombatDecisionReason": {
          "enum": [
            "nearest-reachable",
            "strategic-score",
            "finishing-opportunity",
            "stock-threat",
            "low-health-and-power",
            "retreat-order",
            "regroup-complete",
            null
          ]
        },
        "lastCombatSquadType": {
          "enum": ["assault", "air", "rush", "protection", "naval", null]
        },
        "lastCombatUnitCount": { "type": "integer", "minimum": 0 },
        "lastCombatTargetActorId": { "type": "integer", "minimum": 0 },
        "lastCombatOwnValue": { "type": "integer", "minimum": 0 },
        "lastCombatEnemyValue": { "type": "integer", "minimum": 0 },
        "targetSelectionCount": { "type": "integer", "minimum": 0 },
        "retreatCount": { "type": "integer", "minimum": 0 },
        "regroupCount": { "type": "integer", "minimum": 0 },
        "reengageCount": { "type": "integer", "minimum": 0 },
        "idleBaseUnits": { "type": "integer", "minimum": 0 },
        "committedUnits": { "type": "integer", "minimum": 0 },
        "survivalUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "researchUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "tradeUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "securityUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "recoveryUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "warUtility": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "tradeDependency": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "settlements": {
          "type": "array",
          "items": { "$ref": "#/$defs/settlement" }
        }
      }
    },
    "diplomaticRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "playerA",
        "playerB",
        "state",
        "grievanceA",
        "grievanceB",
        "trust",
        "warExhaustion",
        "warStartedTick",
        "peaceCooldownUntil",
        "transitionTick",
        "transitionSequence",
        "reasonCode"
      ],
      "properties": {
        "relationId": { "type": "string", "minLength": 1 },
        "playerA": { "type": "string", "minLength": 1 },
        "playerB": { "type": "string", "minLength": 1 },
        "state": { "enum": ["neutral", "war", "alliance"] },
        "grievanceA": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "grievanceB": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "trust": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "warExhaustion": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "warStartedTick": { "type": "integer", "minimum": 0 },
        "peaceCooldownUntil": { "type": "integer", "minimum": 0 },
        "transitionTick": { "type": "integer", "minimum": 0 },
        "transitionSequence": { "type": "integer", "minimum": 0 },
        "reasonCode": {
          "enum": [
            "initial-neutrality",
            "strategic-rivalry",
            "war-exhaustion",
            "defensive-response",
            "faction-collapse"
          ]
        }
      }
    },
    "tradeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "playerA",
        "playerB",
        "status",
        "statusReason",
        "distanceCells",
        "capacity",
        "risk",
        "statusSequence",
        "shipmentSequence",
        "lastTradeTick",
        "lastResource",
        "lastAmount",
        "lastExporter",
        "foodAToB",
        "foodBToA",
        "materialsAToB",
        "materialsBToA",
        "energyAToB",
        "energyBToA"
      ],
      "properties": {
        "routeId": { "type": "string", "minLength": 1 },
        "playerA": { "type": "string", "minLength": 1 },
        "playerB": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "suspended"] },
        "statusReason": {
          "enum": [
            "initial-agreement",
            "war-suspension",
            "capacity-unavailable",
            "resumed"
          ]
        },
        "distanceCells": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 0 },
        "risk": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "statusSequence": { "type": "integer", "minimum": 0 },
        "shipmentSequence": { "type": "integer", "minimum": 0 },
        "lastTradeTick": { "type": "integer", "minimum": 0 },
        "lastResource": { "enum": ["none", "food", "materials", "energy"] },
        "lastAmount": { "type": "integer", "minimum": 0 },
        "lastExporter": { "type": "string", "minLength": 1 },
        "foodAToB": { "type": "integer", "minimum": 0 },
        "foodBToA": { "type": "integer", "minimum": 0 },
        "materialsAToB": { "type": "integer", "minimum": 0 },
        "materialsBToA": { "type": "integer", "minimum": 0 },
        "energyAToB": { "type": "integer", "minimum": 0 },
        "energyBToA": { "type": "integer", "minimum": 0 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioMode",
        "observationHorizonTick",
        "hardTickLimit",
        "stalemateWindowTicks",
        "stalemateTerminates",
        "collapsePopulationThreshold",
        "collapseStabilityThreshold",
        "stalemateAdvisory",
        "stalemateSinceTick",
        "lastMeaningfulActivityTick",
        "stalemateSequence",
        "allFactionsCollapsed",
        "collapsedFactions"
      ],
      "properties": {
        "scenarioMode": { "enum": ["conflict", "living-world"] },
        "observationHorizonTick": { "type": "integer", "minimum": 0 },
        "hardTickLimit": { "type": "integer", "minimum": 1 },
        "stalemateWindowTicks": { "type": "integer", "minimum": 0 },
        "stalemateTerminates": { "type": "boolean" },
        "collapsePopulationThreshold": { "type": "integer", "minimum": 0 },
        "collapseStabilityThreshold": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "stalemateAdvisory": { "type": "boolean" },
        "stalemateSinceTick": { "type": "integer", "minimum": 0 },
        "lastMeaningfulActivityTick": { "type": "integer", "minimum": 0 },
        "stalemateSequence": { "type": "integer", "minimum": 0 },
        "allFactionsCollapsed": { "type": "boolean" },
        "collapsedFactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/collapsedFaction" }
        }
      }
    },
    "collapsedFaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerName",
        "botType",
        "faction",
        "collapseTick",
        "population",
        "survivingAssetsValue",
        "reasonCode"
      ],
      "properties": {
        "playerName": { "type": "string", "minLength": 1 },
        "botType": { "type": "string", "minLength": 1 },
        "faction": { "type": "string", "minLength": 1 },
        "collapseTick": { "type": "integer", "minimum": 0 },
        "population": { "type": "integer", "minimum": 0 },
        "survivingAssetsValue": { "type": "integer", "minimum": 0 },
        "reasonCode": { "type": "string", "minLength": 1 }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlementId",
        "actorId",
        "actorType",
        "foundedTick",
        "cellX",
        "cellY",
        "population",
        "children",
        "adults",
        "elders",
        "workforce",
        "employed",
        "housing",
        "jobs",
        "food",
        "materials",
        "energy",
        "knowledge",
        "foodStorage",
        "materialsStorage",
        "energyStorage",
        "foodProduction",
        "materialsProduction",
        "energyProduction",
        "knowledgeProduction",
        "foodDemand",
        "materialsDemand",
        "energyDemand",
        "foodSatisfaction",
        "housingSatisfaction",
        "energySatisfaction",
        "employmentSatisfaction",
        "prosperity",
        "stability",
        "migrationPressure",
        "lastPopulationDelta",
        "civilPulseCount",
        "demographicPulseCount",
        "infrastructureCount"
      ],
      "properties": {
        "settlementId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "actorType": { "type": "string", "minLength": 1 },
        "foundedTick": { "type": "integer", "minimum": 0 },
        "cellX": { "type": "integer" },
        "cellY": { "type": "integer" },
        "population": { "type": "integer", "minimum": 1 },
        "children": { "type": "integer", "minimum": 0 },
        "adults": { "type": "integer", "minimum": 0 },
        "elders": { "type": "integer", "minimum": 0 },
        "workforce": { "type": "integer", "minimum": 0 },
        "availableWorkforce": { "type": "integer", "minimum": 0 },
        "employed": { "type": "integer", "minimum": 0 },
        "mobilized": { "type": "integer", "minimum": 0 },
        "activeWars": { "type": "integer", "minimum": 0 },
        "warCasualties": { "type": "integer", "minimum": 0 },
        "lastWarCasualties": { "type": "integer", "minimum": 0 },
        "housing": { "type": "integer", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "food": { "type": "integer", "minimum": 0 },
        "materials": { "type": "integer", "minimum": 0 },
        "energy": { "type": "integer", "minimum": 0 },
        "knowledge": { "type": "integer", "minimum": 0 },
        "foodStorage": { "type": "integer", "minimum": 0 },
        "materialsStorage": { "type": "integer", "minimum": 0 },
        "energyStorage": { "type": "integer", "minimum": 0 },
        "foodProduction": { "type": "integer", "minimum": 0 },
        "materialsProduction": { "type": "integer", "minimum": 0 },
        "energyProduction": { "type": "integer", "minimum": 0 },
        "knowledgeProduction": { "type": "integer", "minimum": 0 },
        "foodDemand": { "type": "integer", "minimum": 0 },
        "materialsDemand": { "type": "integer", "minimum": 0 },
        "energyDemand": { "type": "integer", "minimum": 0 },
        "foodSatisfaction": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "housingSatisfaction": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "energySatisfaction": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "employmentSatisfaction": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "prosperity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "stability": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "migrationPressure": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "lastPopulationDelta": { "type": "integer" },
        "civilPulseCount": { "type": "integer", "minimum": 0 },
        "demographicPulseCount": { "type": "integer", "minimum": 0 },
        "infrastructureCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
