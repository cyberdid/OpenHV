{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyberdid/OpenHV/schemas/simulation-result-v1.schema.json",
  "title": "Universe simulation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "build",
    "config",
    "endReason",
    "endDetail",
    "startedUtc",
    "endedUtc",
    "worldTick",
    "simulatedSeconds",
    "synchronizedStateHash",
    "botRandomTotalCount",
    "naturalWinners",
    "scoreLeader",
    "players"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "build": { "$ref": "#/$defs/build" },
    "config": { "$ref": "#/$defs/config" },
    "endReason": {
      "enum": [
        "natural-victory",
        "faction-collapse",
        "observation-horizon",
        "world-tick-limit",
        "stalemate",
        "invalid-configuration",
        "desync",
        "crash",
        "external-cancel",
        "watchdog-timeout"
      ]
    },
    "endDetail": { "type": "string" },
    "startedUtc": { "type": "string", "format": "date-time" },
    "endedUtc": { "type": "string", "format": "date-time" },
    "worldTick": { "type": "integer", "minimum": 0 },
    "simulatedSeconds": { "type": "number", "minimum": 0 },
    "synchronizedStateHash": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}$"
    },
    "botRandomTotalCount": { "type": "integer", "minimum": 0 },
    "naturalWinners": {
      "type": "array",
      "items": { "$ref": "#/$defs/leader" }
    },
    "scoreLeader": {
      "oneOf": [
        { "$ref": "#/$defs/leader" },
        { "type": "null" }
      ]
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/playerResult" }
    },
    "diplomacy": {
      "type": "array",
      "items": { "$ref": "#/$defs/diplomaticRelation" }
    },
    "tradeRoutes": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeRoute" }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "universe": {
      "$ref": "#/$defs/universe"
    }
  },
  "$defs": {
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universeId",
        "starSystemId",
        "macroDay",
        "macroTickRemainder",
        "macroEventSequence",
        "ticksPerMacroDay",
        "planets"
      ],
      "properties": {
        "universeId": { "type": "string", "minLength": 1 },
        "starSystemId": { "type": "string", "minLength": 1 },
        "macroDay": { "type": "integer", "minimum": 0 },
        "macroTickRemainder": { "type": "integer", "minimum": 0 },
        "macroEventSequence": { "type": "integer", "minimum": 0 },
        "ticksPerMacroDay": { "type": "integer", "minimum": 1 },
        "planets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/planet" },
          "contains": {
            "type": "object",
            "required": ["active"],
            "properties": { "active": { "const": true } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "planet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planetId",
        "name",
        "index",
        "active",
        "lifecycleStage",
        "physics",
        "surface"
      ],
      "properties": {
        "planetId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0, "maximum": 2 },
        "active": { "type": "boolean" },
        "lifecycleStage": {
          "enum": [
            "lifeless",
            "biosphere",
            "sapient-life",
            "civilization",
            "spacefaring"
          ]
        },
        "nativeRaceId": {
          "type": ["string", "null"]
        },
        "physics": { "$ref": "#/$defs/planetPhysics" },
        "surface": { "$ref": "#/$defs/planetSurface" }
      }
    },
    "planetSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitudeCells", "longitudeCells", "cellCount",
        "chunkLatitudeCells", "chunkLongitudeCells", "chunkRows", "chunkColumns",
		"chunkCount", "generation", "topologyHash", "geologyPulseSequence", "geologyHash",
		"meanElevationMeters", "meanAbsoluteGeologyChangeMilliMeters", "activeVolcanicCellCount",
		"totalSurfaceMaterialUnits", "cumulativeErodedMaterialUnits",
		"cumulativeMantleMaterialInputUnits", "cumulativeTectonicElevationChangeMeters",
		"elevationBalanceErrorMeters", "materialBalanceErrorUnits", "hydrologyHash",
        "climatePulseSequence", "climateHash", "atmosphereHash",
        "minimumElevationMeters", "maximumElevationMeters", "landCellCount",
        "basinCellCount", "minimumTemperatureMilliKelvin", "maximumTemperatureMilliKelvin",
        "meanTemperatureMilliKelvin", "minimumPressurePascals", "maximumPressurePascals",
        "meanPressurePascals", "meanAbsorbedSolarWattsPerSquareMeter",
        "atmosphereSubsteps", "atmosphereStepSeconds", "meanWindCentimetersPerSecond",
        "maximumWindCentimetersPerSecond", "meanAtmosphericWaterPartsPerMillion",
        "meanCloudCoverPerMille", "meanPrecipitationTenthsMillimetersPerDay",
        "spatialSurfaceWaterCubicKilometers", "totalWaterMassUnits", "waterBalanceErrorUnits",
        "verticalLevels", "verticalAtmosphereHash",
        "meanLowerAtmosphereTemperatureMilliKelvin", "meanUpperAtmosphereTemperatureMilliKelvin",
        "meanLowerRelativeHumidityPerMille", "meanUpperRelativeHumidityPerMille",
        "meanVerticalShearMicrosPerSecond", "meanJetSpeedCentimetersPerSecond",
        "maximumJetSpeedCentimetersPerSecond", "meanVerticalVelocityMillimetersPerSecond",
        "meanBulkRichardsonMillionths", "hadleyTemperatureIndexMilliKelvin",
        "meanLatentFluxMilliWattsPerSquareMeter", "latentEnergyResidualMilliWattsPerSquareMeter",
        "cumulativeLatentEnergyMegaJoulesPerSquareMeter",
        "firstCellId", "lastCellId", "firstChunkId", "lastChunkId"
      ],
      "properties": {
        "latitudeCells": { "type": "integer", "minimum": 1 },
        "longitudeCells": { "type": "integer", "minimum": 1 },
        "cellCount": { "type": "integer", "minimum": 1 },
        "chunkLatitudeCells": { "type": "integer", "minimum": 1 },
        "chunkLongitudeCells": { "type": "integer", "minimum": 1 },
        "chunkRows": { "type": "integer", "minimum": 1 },
        "chunkColumns": { "type": "integer", "minimum": 1 },
        "chunkCount": { "type": "integer", "minimum": 1 },
		"generation": { "type": "integer", "minimum": 1 },
		"topologyHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
		"geologyPulseSequence": { "type": "integer", "minimum": 0 },
		"geologyHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
		"meanElevationMeters": { "type": "integer", "minimum": -16000, "maximum": 16000 },
		"meanAbsoluteGeologyChangeMilliMeters": { "type": "integer", "minimum": 0 },
		"activeVolcanicCellCount": { "type": "integer", "minimum": 0, "maximum": 64800 },
		"totalSurfaceMaterialUnits": { "type": "integer", "minimum": 0 },
		"cumulativeErodedMaterialUnits": { "type": "integer", "minimum": 0 },
		"cumulativeMantleMaterialInputUnits": { "type": "integer", "minimum": 0 },
		"cumulativeTectonicElevationChangeMeters": { "type": "integer" },
		"elevationBalanceErrorMeters": { "const": 0 },
		"materialBalanceErrorUnits": { "const": 0 },
		"hydrologyHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
        "climatePulseSequence": { "type": "integer", "minimum": 0 },
        "climateHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
        "atmosphereHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
        "minimumElevationMeters": { "type": "integer" },
        "maximumElevationMeters": { "type": "integer" },
        "landCellCount": { "type": "integer", "minimum": 0 },
        "basinCellCount": { "type": "integer", "minimum": 0 },
        "minimumTemperatureMilliKelvin": { "type": "integer", "minimum": 0 },
        "maximumTemperatureMilliKelvin": { "type": "integer", "minimum": 0 },
        "meanTemperatureMilliKelvin": { "type": "integer", "minimum": 0 },
        "minimumPressurePascals": { "type": "integer", "minimum": 0 },
        "maximumPressurePascals": { "type": "integer", "minimum": 0 },
        "meanPressurePascals": { "type": "integer", "minimum": 0 },
        "meanAbsorbedSolarWattsPerSquareMeter": { "type": "integer", "minimum": 0 },
        "atmosphereSubsteps": { "type": "integer", "minimum": 0, "maximum": 96 },
        "atmosphereStepSeconds": { "type": "integer", "minimum": 0, "maximum": 21600 },
        "meanWindCentimetersPerSecond": { "type": "integer", "minimum": 0 },
        "maximumWindCentimetersPerSecond": { "type": "integer", "minimum": 0, "maximum": 21000 },
        "meanAtmosphericWaterPartsPerMillion": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "meanCloudCoverPerMille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "meanPrecipitationTenthsMillimetersPerDay": { "type": "integer", "minimum": 0 },
        "spatialSurfaceWaterCubicKilometers": { "type": "integer", "minimum": 0 },
        "totalWaterMassUnits": { "type": "integer", "minimum": 0 },
        "waterBalanceErrorUnits": { "const": 0 },
        "verticalLevels": { "const": 8 },
        "verticalAtmosphereHash": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
        "meanLowerAtmosphereTemperatureMilliKelvin": { "type": "integer", "minimum": 140000, "maximum": 900000 },
        "meanUpperAtmosphereTemperatureMilliKelvin": { "type": "integer", "minimum": 140000, "maximum": 900000 },
        "meanLowerRelativeHumidityPerMille": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "meanUpperRelativeHumidityPerMille": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "meanVerticalShearMicrosPerSecond": { "type": "integer", "minimum": 0, "maximum": 500000 },
        "meanJetSpeedCentimetersPerSecond": { "type": "integer", "minimum": 0, "maximum": 27000 },
        "maximumJetSpeedCentimetersPerSecond": { "type": "integer", "minimum": 0, "maximum": 27000 },
        "meanVerticalVelocityMillimetersPerSecond": { "type": "integer", "minimum": 0, "maximum": 900 },
        "meanBulkRichardsonMillionths": { "type": "integer", "minimum": -2000000, "maximum": 12000000 },
        "hadleyTemperatureIndexMilliKelvin": { "type": "integer", "minimum": -900000, "maximum": 900000 },
        "meanLatentFluxMilliWattsPerSquareMeter": { "type": "integer", "minimum": -1500000, "maximum": 1500000 },
        "latentEnergyResidualMilliWattsPerSquareMeter": { "const": 0 },
        "cumulativeLatentEnergyMegaJoulesPerSquareMeter": { "type": "integer" },
        "firstCellId": { "type": "string", "minLength": 1 },
        "lastCellId": { "type": "string", "minLength": 1 },
        "firstChunkId": { "type": "string", "minLength": 1 },
        "lastChunkId": { "type": "string", "minLength": 1 }
      }
    },
    "planetPhysics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geologicalAgeYears", "massEarthMillionths", "radiusKilometers",
        "surfaceGravityMilliMetersPerSecondSquared", "rotationPeriodMinutes",
        "orbitalDistanceMillionKilometers", "orbitalPeriodDays", "axialTiltMilliDegrees",
        "orbitalEccentricityMillionths", "stellarFluxWattsPerSquareMeter",
        "bondAlbedoPerMille", "absorbedSolarWattsPerSquareMeter",
        "radiativeEquilibriumMilliKelvin", "meanSurfaceTemperatureMilliKelvin",
        "energyImbalanceMilliWattsPerSquareMeter", "atmospherePressurePascals",
        "carbonDioxidePartsPerMillion", "atmosphericWaterPartsPerMillion",
        "surfaceWaterCubicKilometers", "oceanCoveragePerMille", "tectonicPlateCount",
        "tectonicActivityPerMille", "climatePulseSequence"
      ],
      "properties": {
        "geologicalAgeYears": { "type": "integer", "minimum": 0 },
        "massEarthMillionths": { "type": "integer", "minimum": 1 },
        "radiusKilometers": { "type": "integer", "minimum": 1 },
        "surfaceGravityMilliMetersPerSecondSquared": { "type": "integer", "minimum": 1 },
        "rotationPeriodMinutes": { "type": "integer", "minimum": 1 },
        "orbitalDistanceMillionKilometers": { "type": "integer", "minimum": 1 },
        "orbitalPeriodDays": { "type": "integer", "minimum": 1 },
        "axialTiltMilliDegrees": { "type": "integer", "minimum": 0, "maximum": 180000 },
        "orbitalEccentricityMillionths": { "type": "integer", "minimum": 0, "maximum": 999999 },
        "stellarFluxWattsPerSquareMeter": { "type": "integer", "minimum": 0 },
        "bondAlbedoPerMille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "absorbedSolarWattsPerSquareMeter": { "type": "integer", "minimum": 0 },
        "radiativeEquilibriumMilliKelvin": { "type": "integer", "minimum": 0 },
        "meanSurfaceTemperatureMilliKelvin": { "type": "integer", "minimum": 0 },
        "energyImbalanceMilliWattsPerSquareMeter": { "type": "integer" },
        "atmospherePressurePascals": { "type": "integer", "minimum": 0 },
        "carbonDioxidePartsPerMillion": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "atmosphericWaterPartsPerMillion": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "surfaceWaterCubicKilometers": { "type": "integer", "minimum": 0 },
        "oceanCoveragePerMille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "tectonicPlateCount": { "type": "integer", "minimum": 0 },
        "tectonicActivityPerMille": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "climatePulseSequence": { "type": "integer", "minimum": 0 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "modId",
        "modVersion",
        "gitCommit",
        "gitDirty"
      ],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "modId": { "type": "string", "minLength": 1 },
        "modVersion": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "minLength": 1 },
        "gitDirty": { "type": "boolean" },
        "executionMode": { "enum": ["graphical", "headless"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "matchId",
        "mapRequest",
        "mapUid",
        "mapTitle",
        "mapHash",
        "botTypes",
        "gameSpeed",
        "gameTimestepMilliseconds",
        "requestedRandomSeed",
        "effectiveRandomSeed",
        "maxWorldTicks",
        "watchdogSeconds",
        "telemetryIntervalTicks",
        "gitCommit",
        "gitDirty",
        "resultPath",
        "players"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "matchId": { "type": "string", "minLength": 1 },
        "mapRequest": { "type": "string", "minLength": 1 },
        "mapUid": { "type": "string", "minLength": 1 },
        "mapTitle": { "type": "string", "minLength": 1 },
        "mapHash": { "type": "string", "minLength": 1 },
        "botTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "type": "boolean" },
        "deterministicSimulation": { "type": "boolean" },
        "gameSpeed": { "type": "string", "minLength": 1 },
        "gameTimestepMilliseconds": { "type": "integer", "minimum": 1 },
        "requestedRandomSeed": {
          "type": ["integer", "null"]
        },
        "effectiveRandomSeed": { "type": "integer" },
        "maxWorldTicks": { "type": "integer", "minimum": 1 },
        "scenarioMode": { "enum": ["conflict", "living-world"] },
        "observationHorizonTicks": { "type": "integer", "minimum": 0 },
        "stalemateWindowTicks": { "type": "integer", "minimum": 0 },
        "stalemateTerminates": { "type": "boolean" },
        "collapsePopulationThreshold": { "type": "integer", "minimum": 0 },
        "collapseStabilityThreshold": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "watchdogSeconds": { "type": "integer", "minimum": 0 },
        "telemetryIntervalTicks": { "type": "integer", "minimum": 0 },
        "civilizationProfile": { "enum": ["balanced", "scarcity", "trade"] },
        "tradeEnabled": { "type": "boolean" },
        "factions": { "type": "array", "items": { "type": "string" } },
        "gitCommit": { "type": "string", "minLength": 1 },
        "gitDirty": { "type": "boolean" },
        "resultPath": { "type": "string" },
        "checkpointWorldTick": { "type": "integer", "minimum": 0 },
        "checkpointName": { "type": "string" },
        "loadCheckpointName": { "type": "string" },
        "players": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/playerConfig" }
        }
      }
    },
    "leader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerName", "botType", "faction"],
      "properties": {
        "playerName": { "type": "string" },
        "botType": { "type": "string" },
        "faction": { "type": "string" }
      }
    },
    "playerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "playerName",
        "botType",
        "faction",
        "team",
        "color",
        "spawnPoint",
        "homeCellX",
        "homeCellY"
      ],
      "properties": {
        "slot": { "type": "string" },
        "playerName": { "type": "string" },
        "botType": { "type": "string" },
        "faction": { "type": "string" },
        "team": { "type": "integer", "minimum": 0 },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}([0-9A-F]{2})?$"
        },
        "spawnPoint": { "type": "integer", "minimum": 0 },
        "homeCellX": { "type": "integer" },
        "homeCellY": { "type": "integer" }
      }
    },
    "playerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
            "slot",
            "playerName",
            "botType",
            "faction",
            "team",
            "color",
            "spawnPoint",
            "homeCellX",
            "homeCellY",
            "outcome",
            "score",
            "experience",
            "killsValue",
            "deathsValue",
            "unitsKilled",
            "unitsLost",
            "buildingsKilled",
            "buildingsLost",
            "armyValue",
            "assetsValue",
            "cashAndResources",
            "earned",
            "spent"
      ],
      "properties": {
            "slot": { "type": "string" },
            "playerName": { "type": "string" },
            "botType": { "type": "string" },
            "faction": { "type": "string" },
            "team": { "type": "integer", "minimum": 0 },
            "color": { "type": "string" },
            "spawnPoint": { "type": "integer", "minimum": 0 },
            "homeCellX": { "type": "integer" },
            "homeCellY": { "type": "integer" },
            "outcome": {
              "enum": ["undefined", "won", "lost"]
            },
            "score": { "type": "integer" },
            "experience": { "type": "integer", "minimum": 0 },
            "killsValue": { "type": "integer", "minimum": 0 },
            "deathsValue": { "type": "integer", "minimum": 0 },
            "unitsKilled": { "type": "integer", "minimum": 0 },
            "unitsLost": { "type": "integer", "minimum": 0 },
            "buildingsKilled": { "type": "integer", "minimum": 0 },
            "buildingsLost": { "type": "integer", "minimum": 0 },
            "armyValue": { "type": "integer", "minimum": 0 },
            "assetsValue": { "type": "integer", "minimum": 0 },
            "cashAndResources": { "type": "integer", "minimum": 0 },
            "earned": { "type": "integer", "minimum": 0 },
            "spent": { "type": "integer", "minimum": 0 },
            "civilization": { "$ref": "#/$defs/civilization" }
      }
    },
    "civilization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "foundedTick",
        "population",
        "children",
        "adults",
        "elders",
        "workforce",
        "employed",
        "housing",
        "jobs",
        "food",
        "materials",
        "energy",
        "knowledge",
        "foodProduction",
        "materialsProduction",
        "energyProduction",
        "knowledgeProduction",
        "prosperity",
        "stability",
        "migrationPressure",
        "settlements"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "foundedTick": { "type": "integer", "minimum": 0 },
        "population": { "type": "integer", "minimum": 0 },
        "children": { "type": "integer", "minimum": 0 },
        "adults": { "type": "integer", "minimum": 0 },
        "elders": { "type": "integer", "minimum": 0 },
        "workforce": { "type": "integer", "minimum": 0 },
        "availableWorkforce": { "type": "integer", "minimum": 0 },
        "employed": { "type": "integer", "minimum": 0 },
        "mobilized": { "type": "integer", "minimum": 0 },
        "activeWars": { "type": "integer", "minimum": 0 },
        "warCasualties": { "type": "integer", "minimum": 0 },
        "lastWarCasualties": { "type": "integer", "minimum": 0 },
        "housing": { "type": "integer", "minimum": 0 },
        "jobs": { "type": "integer", "minimum": 0 },
        "food": { "type": "integer", "minimum": 0 },
        "materials": { "type": "integer", "minimum": 0 },
        "energy": { "type": "integer", "minimum": 0 },
        "knowledge": { "type": "integer", "minimum": 0 },
        "foodProduction": { "type": "integer", "minimum": 0 },
        "materialsProduction": { "type": "integer", "minimum": 0 },
        "energyProduction": { "type": "integer", "minimum": 0 },
        "knowledgeProduction": { "type": "integer", "minimum": 0 },
        "prosperity": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "stability": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "migrationPressure": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "completedTechnologies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentTechnology": {
          "type": ["string", "null"]
        },
        "researchProgress": { "type": "integer", "minimum": 0 },
        "researchCost": { "type": "integer", "minimum": 0 },
        "researchMaterialsSpent": { "type": "integer", "minimum": 0 },
        "researchEnergySpent": { "type": "integer", "minimum": 0 },
        "strategy": {
          "enum": [
            "development",
            "survival",
            "research",
            "trade",
            "mobilization",
            "recovery"
          ]
        },
        "strategySequence": { "type": "integer", "minimum": 0 },
        "strategyTransitionTick": { "type": "integer", "minimum": 0 },
        "plan": {
          "enum": ["opening", "economy", "technology", "recovery"]
        },
        "planReason": {
          "enum": [
            "opening-window",
            "crisis-recovery",
            "technologist-doctrine",
            "economist-doctrine",
            "research-strategy",
            "development-doctrine"
          ]
        },
        "planSequence": { "type": "integer", "minimum": 0 },
        "planTransitionTick": { "type": "integer", "minimum": 0 },
        "plannerRequestSequence": { "type": "integer", "minimum": 0 },
        "lastPlannerRequestTick": { "type": "integer", "minimum": 0 },
        "lastPlannerRequestActor": { "type": ["string", "null"] },
        "combatDecisionSequence": { "type": "integer", "minimum": 0 },
        "lastCombatDecisionTick": { "type": "integer", "minimum": 0 },
        "lastCombatDecision": {
          "enum": ["target-selected", "retreat", "regroup", "reengage", null]
        },
        "lastCombatDecisionReason": {
          "enum": [
            "nearest-reachable",
            "strategic-score",
