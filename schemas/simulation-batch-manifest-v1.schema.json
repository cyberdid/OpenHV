{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cyberdid/OpenHV/schemas/simulation-batch-manifest-v1.schema.json",
  "title": "Universe simulation batch manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "defaults", "matches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "description": { "type": "string" },
    "defaults": { "$ref": "#/$defs/defaultOptions" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxInfrastructureRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "processTimeoutGraceSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "successfulReplaySampleEvery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/matchOptions" },
          {
            "type": "object",
            "required": ["map", "seed"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "map": { "type": "string", "minLength": 1 },
              "seed": { "type": "integer" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "defaultOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "type": "boolean" },
        "gameSpeed": { "type": "string", "minLength": 1 },
        "maxWorldTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "scenarioMode": {
          "enum": ["conflict", "living-world"]
        },
        "observationHorizonTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stalemateWindowTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stalemateTerminates": {
          "type": "boolean"
        },
        "collapsePopulationThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "collapseStabilityThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "watchdogSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "telemetryIntervalTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "civilizationProfile": {
          "enum": ["balanced", "scarcity", "trade"]
        },
        "tradeEnabled": {
          "type": "boolean"
        }
      }
    },
    "matchOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "map": { "type": "string", "minLength": 1 },
        "seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "bots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "headless": { "type": "boolean" },
        "gameSpeed": { "type": "string", "minLength": 1 },
        "maxWorldTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "scenarioMode": {
          "enum": ["conflict", "living-world"]
        },
        "observationHorizonTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stalemateWindowTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stalemateTerminates": {
          "type": "boolean"
        },
        "collapsePopulationThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "collapseStabilityThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "watchdogSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "telemetryIntervalTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "civilizationProfile": {
          "enum": ["balanced", "scarcity", "trade"]
        },
        "tradeEnabled": {
          "type": "boolean"
        }
      }
    }
  }
}
