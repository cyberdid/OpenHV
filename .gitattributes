# Enforce LF normalization on Windows
*.pal eol=lf
*.yaml eol=lf
*.lua eol=lf
*.cs eol=lf
*.csproj eol=lf
*.sln eol=lf
* text=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Patch payloads contain diff context markers that intentionally precede tabs
# and blank lines; do not reinterpret those markers as source whitespace.
engine-patches/*.patch -whitespace
